+          const tag = `${layout} v${variant} ${overlay}${mirror ? ' mirrored' : ''}`;
+          assert.ok(h >= 800 && h <= 1400, `${tag}: height ${h}`);
+          const metas = b.bodies.map(meta);
+          const surfaces = b.bodies.filter(body => !!meta(body).surface && ['ramp', 'ice', 'conveyor'].includes(meta(body).kind));
+          assert.ok(surfaces.length >= 2, `${tag}: needs two rolling surfaces`);
+          assert.ok(metas.some(m => m.kind === 'ppeg' && m.pegColor === 'green' && !!m.itemDrop), `${tag}: needs a green supply peg`);
+          assert.ok(metas.some(m => m.kind === 'itembox'), `${tag}: needs an item box`);
