+// ---------------------------------------------------------------------------------------------
+// Signature chapter library: every Grand Prix has its own layouts, chosen by theme affinity.
+// ---------------------------------------------------------------------------------------------
+
+const gp = (short: string) => CALENDAR.find(g => g.short === short)!;
+const SIGNATURES: Record<string, CourseLayout[]> = {
+  MARBLEHURST: ['fairground', 'watermill', 'funhouse'],
+  'MONTE PIPO': ['tunnelrun', 'cannonalley', 'bladestreet'],
+  SILVERPEG: ['pegboard', 'targetrange', 'turnstiles'],
+  SPA: ['icecascade', 'looprun', 'rapids'],
+  SUZUKA: ['macealley', 'magnetcave', 'boulderrun'],
+};
+const layoutCounts = (short: string, seeds = 256) => {
+  const counts = Object.fromEntries(COURSE_LAYOUTS.map(l => [l, 0])) as Record<CourseLayout, number>;
+  for (let seed = 0; seed < seeds; seed++) {
+    for (const chapter of planCourse(seed, gp(short).profile)) if (chapter.layout) counts[chapter.layout]++;
+  }
+  return counts;
+};
+
+test('the chapter library is large and every layout and feature has a builder name and an affinity', () => {
+  assert.ok(COURSE_LAYOUTS.length >= 20, 'five archetypes plus fifteen GP signatures');
+  assert.ok(COURSE_FEATURES.length >= 10, 'five original overlays plus five new ones');
+  for (const layout of COURSE_LAYOUTS) assert.ok(LAYOUT_NAMES[layout], `${layout} needs a sector name`);
+  for (const theme of ['classic', 'street', 'silver', 'forest', 'worg', 'dwarven']) assert.ok(AFFINITY[theme], `${theme} needs an affinity row`);
+  for (const [short, layouts] of Object.entries(SIGNATURES)) {
+    const theme = ['classic', 'street', 'silver', 'forest', 'worg'][Object.keys(SIGNATURES).indexOf(short)];
+    for (const layout of layouts) assert.ok((AFFINITY[theme][layout] ?? 0) >= 4, `${short} should favour ${layout}`);
+  }
+});
+
+test('signature chapters carry a layout and an overlay, never sit side by side with an identical layout, and stay deterministic', () => {
+  for (const round of CALENDAR) {
+    for (let seed = 0; seed < 64; seed++) {
+      const plan = planCourse(seed, round.profile);
+      const layouts = plan.filter(c => c.layout);
+      assert.ok(layouts.length >= 1, `${round.short} seed ${seed}: at least one signature chapter`);
+      for (const c of layouts) {
+        assert.ok(isCourseLayout(c.feature) && c.feature === c.layout);
+        assert.ok(c.overlay && (COURSE_FEATURES as readonly string[]).includes(c.overlay));
+      }
+      assert.ok(plan.every((c, i) => i === 0 || c.feature !== plan[i - 1].feature));
+      assert.deepEqual(planCourse(seed, round.profile), plan);
+    }
+  }
+});
+
+test('new layouts appear in generated plans where the theme bias should select them', () => {
+  for (const [short, layouts] of Object.entries(SIGNATURES)) {
+    const counts = layoutCounts(short, 64);
+    assert.ok(layouts.some(l => counts[l] > 0), `${short} never produced ${layouts.join('/')}`);
+  }
+  // The finale draws from the whole library.
+  const yas = layoutCounts('YAS MARBLE', 256);
+  assert.ok(COURSE_LAYOUTS.filter(l => yas[l] > 0).length >= 15, 'Yas Marble should use most of the library');
+});
