+  const spa = layoutCounts('SPA'), suzuka = layoutCounts('SUZUKA');
+  const sum = (c: Record<CourseLayout, number>, ls: CourseLayout[]) => ls.reduce((n, l) => n + c[l], 0);
+  assert.ok(sum(silverpeg, ['pegboard', 'targetrange']) > sum(suzuka, ['pegboard', 'targetrange']) * 2, 'Silverpeg must out-peg Suzuka');
